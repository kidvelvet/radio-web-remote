# systemd user service for radio-web-remote. install.sh --service writes this
# to ~/.config/systemd/user/ with @EXE@ filled in, then enables it.
#
# Manage:   systemctl --user status|restart|stop radio-web-remote
# Logs:     journalctl --user -u radio-web-remote
# Without a login session (headless Raspberry Pi), let it run anyway:
#           sudo loginctl enable-linger $USER
#
# Restart=always matters for safety: a key sent over CI-V survives the
# server dying (docs/hardware-test.md, H7300-4 C), and the server sends TX off
# first thing when it starts. Also set the radio's own Time-Out Timer
# (docs/radio-setup.md).

[Unit]
Description=radio-web-remote (browser remote for amateur radio transceivers)
After=network-online.target sound.target

[Service]
ExecStart=@EXE@ serve
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
