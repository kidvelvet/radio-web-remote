# systemd user service for radio-web-remote, as install.sh --service writes it
# to ~/.config/systemd/user/ (with the program and data paths filled in).
#
# Manage:   systemctl --user status|restart|stop radio-web-remote
# Logs:     journalctl --user -u radio-web-remote
# Without a login session (headless Raspberry Pi), let it run anyway:
#           sudo loginctl enable-linger $USER
#
# Restart=always matters for safety: a key sent over CI-V survives the
# server dying (docs/hardware-test.md, H7300-4 C), and the server sends TX off
# first thing when it starts. Also set the radio's own Time-Out Timer
# (docs/radio-setup.md).

[Unit]
Description=radio-web-remote (browser remote for amateur radio transceivers)

[Service]
ExecStart="@EXE@" serve
# The data folder, so a stray ./config.yaml in the home folder is not picked up.
Environment="RADIO_WEB_REMOTE_HOME=@DATA@"
WorkingDirectory=@DATA@
Restart=always
RestartSec=3
# 78: setup incomplete (no admin yet, bad config). Restarting cannot help;
# any other exit, a crash included, restarts (the server sends TX off first).
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
